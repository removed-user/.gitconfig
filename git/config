[core]
   fileMode = true
   ignoreCase = false
   logAllRefUpdates = true
   symlinks = false
   protectHFS = false
   protectNTFS = false
   autocrlf = false
   eol = lf
   attributesfile = ~/.config/git/attributes
   excludesFile = ~/.config/git/ignore
   sshCommand = "${HOME}"/.config/git/shell/ssh_agent/ssh_command.dash

[ssh]
variant = ssh

[init]
   defaultBranch = main

[rebase]
   autostash = 1

[diff]
   algorithm = histogram
[merge]
tool = nvimdiff
[merge "null"]
	name = null driver Ignores lockfiles
	driver = true
[fetch]
prune = true

[mergetool]
    prompt = false
[mergetool "nvimdiff"]
    layout = "(LOCAL,REMOTE) / MERGED"
[log]
   graphcolors = true

[help]
   autocorrect = "50"

[include]
    path = host/insteadOf
    path = host/perhost_switch
    path = aliases/core
    path = aliases/setup
