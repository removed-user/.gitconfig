[core]
   fileMode = true
   ignoreCase = false
   logAllRefUpdates = true
   symlinks = false
   protectHFS = false
   protectNTFS = false
   autocrlf = false
   eol = lf
   attributesfile = ~/.config/git/attributes
   excludesFile = ~/.config/git/ignore
   

[init]
   defaultBranch = main

[rebase]
   autostash = 1

[diff]
   algorithm = histogram

[merge]
merge.null.driver = true
[log]
graphcolors = true
[help]
   autocorrect = "50"


[url git@github.com:]
   insteadOf = https://git@github.com/
[url git@gitlab.com:]
   insteadOf = https://git@gitlab.com/

# GitHub (HTTPS and SSH)
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/host/github
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/host/github

# GitLab (HTTPS and SSH)
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
    path = ~/.config/git/host/gitlab
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = ~/.config/git/host/gitlab
