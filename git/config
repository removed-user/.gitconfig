[core]
   fileMode = true
   ignoreCase = false
   logAllRefUpdates = true
   symlinks = false
   protectHFS = false
   protectNTFS = false
   autocrlf = false
   eol = lf
   attributesfile = ~/.config/git/attributes
   excludesFile = ~/.config/git/ignore
   

[init]
   defaultBranch = main

[rebase]
   autostash = 1

[diff]
   algorithm = histogram

[merge]
merge.null.driver = true
[log]
graphcolors = true
[help]
   autocorrect = "50"

[include]
    path = ~/.config/git/host/platform

[url git@github.com:]
   insteadOf = https://git@github.com/
[url git@gitlab.com:]
   insteadOf = https://git@gitlab.com/
