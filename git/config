[core]
   fileMode = true
   ignoreCase = false
   logAllRefUpdates = true
   symlinks = false
   protectHFS = false
   protectNTFS = false
   autocrlf = false
   eol = lf
   attributesfile = ~/.config/git/attributes
   excludesFile = ~/.config/git/ignore
   sshCommand = sh -c '. "$HOME/.config/git/shell/ssh_agent_setup.sh" && SSH_AUTH_SOCK="$GIT_SSH_AUTH_SOCK" exec ssh "$@"' _

[init]
   defaultBranch = main

[rebase]
   autostash = 1

[diff]
   algorithm = histogram

[merge "null"]
	name = null driver Ignores lockfiles
	driver = true

[log]
   graphcolors = true

[help]
   autocorrect = "50"

[include]
    path = host/perhost_switch
    path = host/insteadOf
    path = aliases/core
    path = aliases/setup
