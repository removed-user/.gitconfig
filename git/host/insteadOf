[url "https://gitlab.com/"]
   insteadOf = http://gitlab.com/
   insteadOf = gl:

[url  "https://salsa.debian.org"]
   insteadOf = http://salsa.debian.org
   insteadOf = salsa:

[url "https://github.com/"]
   insteadOf = http://github.com/
   insteadOf = gh:

### Standardize SSH URI syntax
[url "ssh://git@github.com/removed-user"]
   pushInsteadOf = git@github.com:removed-user
   pushInsteadOf = gh:removed-user
   pushInsteadOf = http://github.com/removed-user
   pushInsteadOf = https://github.com/removed-user

