#!/bin/dash

-v APPLICATION="${APPLICATION}"


END {
    if ( $2 == "" || $4 == "") {
      print "Error: matching credential not found" > "/dev/stderr"
      exit 1
    }


## example
awk '{
    cmd = "echo " $1 " | xxd -r -p | base64 -w 70"
    full_output = ""
    while ((cmd | getline line) > 0) {
        full_output = full_output (full_output ? "\n" : "") line
    }
    close(cmd)
    print $1, "->\n" full_output
}' hex_list.txt


cmd_c = "printf %s \"" cred_b64 "\" | base64 -d | xxd -p -c 0"
    cmd_p = "printf %s \"" pub_b64  "\" | base64 -d | xxd -p -c 0"
    cmd_c | getline cred_hex; close(cmd_c)
    cmd_p | getline pub_hex;  close(cmd_p)
