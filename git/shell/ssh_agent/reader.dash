#!/bin/dash

-v APPLICATION="${APPLICATION}"


END {
    if ( $2 == "" || $4 == "") {
      print "Error: matching credential not found" > "/dev/stderr"
      exit 1
    }


## example
awk '{
    cmd = "echo " $1 " | xxd -r -p | base64 -w 70"
    output = ""
    cmd | getline  output
    close(cmd)
    print $1, "\n" output
}' hex_list.txt


    cmd = "printf %s \"" var "\" | base64 -d | xxd -p -c 0"
    cmd | getline var; close(cmd)
