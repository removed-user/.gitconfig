#!/bin/dash
AUTHENTICATOR_DEVICES=$(fido2-token -L | awk -F ':' '${print $1}')

case "${#AUTHENTICATOR_DEVICES}" in
           [0]) 'No Authenticator present'
''|0*|*[!0-9]*) 'Invalid Input'
           [1]) AUTHENTICATOR_DEVICE="${AUTHENTICATOR_DEVICES[0]}" && unset "${AUTHENTICATOR_DEVICES}"
         [2-9]) 'More than one Authenticator present; pass `AUTHENTICATOR_DEVICE=` explicitly'
esac

-v APPLICATION="${APPLICATION}"


END {
    if ( $2 == "" || $4 == "") {
      print "Error: matching credential not found" > "/dev/stderr"
      exit 1
    }


## example
awk '{
    cmd = "echo " $1 " | xxd -r -p | base64 -w 70"
    output = ""
    cmd | getline  output
    close(cmd)
    print $1, "\n" output
}' hex_list.txt


    cmd = "printf %s \"" var "\" | base64 -d | xxd -p -c 0"
    cmd | getline var; close(cmd)

    fido2-token -L -k "${RELYING_PARTY}" "${AUTHENTICATOR_DEVICE}" |\
awk '{
id =$2
user = $2
}'
